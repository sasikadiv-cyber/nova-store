# Copy to .env (local) or set in your hosting platform.

# PostgreSQL connection string.
DATABASE_URL=postgresql://user:password@host:5432/database

# Console sign-in for the store owner. Set a strong, unique password.
ADMIN_EMAIL=owner@example.com
ADMIN_PASSWORD=change-me-to-something-long

# Session signing keys — REQUIRED in production. Generate with:
#   openssl rand -base64 48
# The app refuses to start in production with the fallback keys.
ADMIN_SECRET=paste-a-long-random-value
CUSTOMER_SECRET=paste-a-different-long-random-value
