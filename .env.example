# Copy to .env (local) or set in your hosting platform.

# PostgreSQL connection string.
DATABASE_URL=postgresql://user:password@host:5432/database

# Console sign-in for the store owner. Set a strong, unique password.
ADMIN_EMAIL=owner@example.com
ADMIN_PASSWORD=change-me-to-something-long

# Session signing keys — REQUIRED in production. Generate with:
#   openssl rand -base64 48
# The app refuses to start in production with the fallback keys.
ADMIN_SECRET=paste-a-long-random-value
CUSTOMER_SECRET=paste-a-different-long-random-value

# Stripe Checkout (card payments). Without these the store keeps its demo
# checkout, so it is safe to deploy before payments are switched on.
#   Dashboard -> Developers -> API keys       -> secret key
#   Dashboard -> Developers -> Webhooks       -> signing secret
STRIPE_SECRET_KEY=sk_live_or_test_key
STRIPE_WEBHOOK_SECRET=whsec_from_the_webhook_settings

# Webhook endpoint to register with Stripe (POST):
#   https://your-domain.com/api/stripe/webhook
# Events: checkout.session.completed, checkout.session.expired,
#         checkout.session.async_payment_succeeded,
#         checkout.session.async_payment_failed
